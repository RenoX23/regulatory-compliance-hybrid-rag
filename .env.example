# Regulatory Compliance Hybrid RAG - Environment Configuration
# Copy this file to .env and fill in the values

# LLM Providers (At least one required)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Embedding Configuration
EMBEDDING_PROVIDER=sentence_transformers  # options: sentence_transformers, gemini
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Alternative Gemini embedding: models/text-embedding-004

# Reranker Configuration
RERANKER_MODEL=BAAI/bge-reranker-base

# Vector Store
CHROMA_PERSIST_DIRECTORY=./data/chroma_db
CHROMA_COLLECTION_NAME=regulatory_compliance_rbi_sebi

# Generation Configuration
DEFAULT_LLM_PROVIDER=gemini  # options: gemini, groq
GEMINI_MODEL=gemini-1.5-flash
GROQ_MODEL=llama-3.3-70b-versatile

# RAG Hyperparameters
RETRIEVAL_DENSE_TOP_K=20
RETRIEVAL_SPARSE_TOP_K=20
RRF_K=60
RERANK_TOP_N=3
MIN_CONFIDENCE_THRESHOLD=0.35

# Application
APP_HOST=0.0.0.0
APP_PORT=8000
